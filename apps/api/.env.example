# ---------------------------------------------------------------------------
# Copy to `.env` and adjust for your environment.
# Never commit real secrets.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4200

# PostgreSQL connection string (matches docker-compose.yml; host port 5433
# avoids clashing with an existing local PostgreSQL on 5432)
DATABASE_URL="postgresql://taskapp:taskapp@localhost:5433/taskapp?schema=public"

# Access tokens are signed with this secret. Use at least 32 random characters.
JWT_ACCESS_SECRET="dev-only-change-me-6f2c1d9a4b7e8c3f5a1d2e9b4c7f8a3d"
JWT_ACCESS_TTL=15m

# Refresh token lifetime (days) and cookie scope
REFRESH_TOKEN_TTL_DAYS=30
# COOKIE_DOMAIN=

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3100

BCRYPT_ROUNDS=12
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Object storage (private S3 bucket, or LocalStack locally)
# ---------------------------------------------------------------------------
# In AWS the bucket and region are supplied by the deployment environment and
# credentials come from the EC2 instance profile. Do not add long-lived keys
# to production.
AWS_REGION=us-east-1
S3_BUCKET=taskapp-attachments
S3_KEY_PREFIX=attachments
S3_UPLOAD_URL_TTL_SECONDS=300
S3_DOWNLOAD_URL_TTL_SECONDS=300
S3_MAX_FILE_BYTES=26214400

# Local LocalStack only. Remove this block when running against AWS S3; the
# EC2 instance profile then supplies credentials automatically.
S3_ENDPOINT_URL=http://localhost:4566
# Only needed when the API runs in a container and reaches LocalStack through a
# different hostname than the browser. Set to http://localhost:4566 there.
# S3_PUBLIC_ENDPOINT_URL=http://localhost:4566
S3_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
