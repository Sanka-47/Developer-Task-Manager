aws_region        = "eu-central-1"
project           = "taskapp"
environment       = "demo"
domain_name       = "app.example.com"
hosted_zone_name  = "example.com"
alert_email       = "you@example.com"
instance_type     = "t3.small"
db_instance_class = "db.t4g.micro"
monthly_budget_usd = 50

# Use a Git SHA for every deployment image. The first apply can use "initial"
# because images are pushed after the ECR repositories exist.
image_tag = "initial"

# Optional: creates an OIDC deploy role for this repository.
github_repository = "your-org/TaskApp"
github_branch     = "main"
